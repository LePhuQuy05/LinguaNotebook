# LinguaNotebook Environment Configuration
# Copy to .env and fill in values

# General
SECRET_KEY=change-me-to-a-random-secret-key
ENVIRONMENT=development
SELF_HOSTED=false
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linguanotebook
POSTGRES_USER=linguanotebook
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# S3 / MinIO Storage
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=linguanotebook
STORAGE_USE_SSL=false

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth (optional — skip for self-hosted)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GPU (self-hosted)
GPU_ENABLED=false
HPD_MODEL_PATH=./model

# Donations (cloud only — external platform links)
GITHUB_SPONSORS_URL=https://github.com/sponsors/LePhuQuy05
KOFI_URL=

# Monitoring (cloud only)
SENTRY_DSN=
